{
  "name": "popcornready",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:mobile": "turbo run test:e2e:mobile --filter=@popcorn/web",
    "test:e2e:local-db": "AUTH_MODE=supabase POPCORN_E2E_AUTH_MODE=supabase node scripts/with-local-supabase-env.mjs pnpm --filter @popcorn/web test:e2e",
    "lint": "turbo run lint",
    "dev:local-db": "node scripts/with-local-supabase-env.mjs pnpm dev",
    "dev:api": "turbo run dev --filter=@popcorn/api",
    "dev:web": "turbo run dev --filter=@popcorn/web",
    "dev:device": "pnpm --filter @popcorn/web dev:device",
    "db:local:start": "supabase start",
    "db:local:reset": "supabase db reset",
    "db:local:status": "supabase status",
    "db:local:test:e2e": "AUTH_MODE=supabase POPCORN_E2E_AUTH_MODE=supabase node scripts/with-local-supabase-env.mjs pnpm --filter @popcorn/web test:e2e",
    "db:migrations:test": "node --test scripts/validate-supabase-migrations.test.mjs",
    "db:migrations:validate": "node scripts/validate-supabase-migrations.mjs",
    "db:rpc-boundary:test": "node --test scripts/validate-api-rpc-boundary.test.mjs",
    "db:rpc-boundary:validate": "node scripts/validate-api-rpc-boundary.mjs",
    "db:relations:test": "node --test scripts/validate-api-db-relations.test.mjs",
    "db:relations:validate": "node scripts/validate-api-db-relations.mjs",
    "db:contracts:test:local": "RUN_LOCAL_DB_INTEGRATION=1 node scripts/with-local-supabase-env.mjs pnpm --filter @popcorn/api exec tsx --test src/lib/orchestrator-context/__tests__/graph-snapshot.integration.test.ts src/lib/orchestrator-context/__tests__/graph-snapshot-access.integration.test.ts",
    "prod:storyboard": "node scripts/start-storyboard-from-prompt.mjs",
    "agent:lint": "node scripts/agent-lint.mjs",
    "agent:lint:fix": "node scripts/agent-lint.mjs --fix",
    "agent:hooks:install": "node scripts/install-agent-hooks.mjs",
    "agent:validate": "node scripts/agent-validate.mjs",
    "agent:review": "bash scripts/agent-review.sh",
    "agent:sweep": "node scripts/agent-sweep.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3"
  }
}
