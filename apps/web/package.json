{
  "name": "@popcorn/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview",
    "preview": "vite preview",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:local-db": "node ../../scripts/with-local-supabase-env.mjs pnpm --filter @popcorn/web test:e2e",
    "test:e2e:hosted": "POPCORN_E2E_AUTH_MODE=supabase playwright test e2e/auth-hosted.spec.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@popcorn/eval": "workspace:*",
    "@popcorn/renderer": "workspace:*",
    "@popcorn/shared": "workspace:*",
    "@popcorn/timeline": "workspace:*",
    "@remotion/player": "^4.0.0",
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/react-query": "^5.101.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.28.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^20.19.41",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "tsx": "^4.22.3",
    "vite": "^5.4.11"
  }
}
