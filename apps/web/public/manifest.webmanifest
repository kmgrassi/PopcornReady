{
  "name": "Popcorn Ready",
  "short_name": "Popcorn",
  "description": "AI-native video studio for turning clips and prompts into finished videos.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#08070a",
  "theme_color": "#08070a",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "media",
          "accept": ["video/*", "image/*"]
        }
      ]
    }
  }
}
